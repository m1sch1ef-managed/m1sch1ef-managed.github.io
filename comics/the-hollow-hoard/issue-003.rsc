4:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"The Hollow Hoard — Edition 3: The Counterfeit Crown | M1sch1ef Managed"}],["$","meta","1",{"name":"description","content":"A glittering auction offers Ren the career he wanted. Looking closer at its impossible crown could cost him everything."}],["$","meta","2",{"name":"robots","content":"index, follow"}],["$","meta","3",{"property":"og:title","content":"The Hollow Hoard — Edition 3: The Counterfeit Crown | M1sch1ef Managed"}],["$","meta","4",{"property":"og:description","content":"A glittering auction offers Ren the career he wanted. Looking closer at its impossible crown could cost him everything."}],["$","meta","5",{"property":"og:url","content":"https://m1sch1efmanaged.com/comics/the-hollow-hoard/issue-003"}],["$","meta","6",{"property":"og:site_name","content":"M1sch1ef Managed"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"property":"og:image","content":"https://m1sch1efmanaged.com/comics/the-hollow-hoard/issue-003/images/00-cover.webp"}],["$","meta","9",{"property":"og:image:width","content":"1024"}],["$","meta","10",{"property":"og:image:height","content":"1536"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"The Hollow Hoard — Edition 3: The Counterfeit Crown | M1sch1ef Managed"}],["$","meta","13",{"name":"twitter:description","content":"A glittering auction offers Ren the career he wanted. Looking closer at its impossible crown could cost him everything."}],["$","meta","14",{"name":"twitter:image","content":"https://m1sch1efmanaged.com/comics/the-hollow-hoard/issue-003/images/00-cover.webp"}],["$","link","15",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.ico","type":"$undefined","sizes":"48x48","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/f