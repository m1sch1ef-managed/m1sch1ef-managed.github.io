10:T44a,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://m1sch1efmanaged.com/#organization","name":"M1sch1ef Managed","url":"https://m1sch1efmanaged.com/"},{"@type":"WebPage","url":"https://m1sch1efmanaged.com/comics/the-hollow-hoard/issue-002","name":"The Hollow Hoard — Edition 2: The Borrowed Flame","description":"Ren and Tamsin need a night of warmth for Latch. A kiln owner offers work, while a retrieval team follows their trail.","inLanguage":"en","isAccessibleForFree":true,"publisher":{"@id":"https://m1sch1efmanaged.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://m1sch1efmanaged.com/"},{"@type":"ListItem","position":2,"name":"M1sch1ef Comics","item":"https://m1sch1efmanaged.com/comics"},{"@type":"ListItem","position":3,"name":"The Hollow Hoard","item":"https://m1sch1efmanaged.com/comics/the-hollow-hoard"},{"@type":"ListItem","position":4,"name":"The Hollow Hoard — Edition 2: The Borrowed Flame","item":"https://m1sch1efmanaged.com/comics/the-hollow-hoard/issue-002"}]}]}1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11","the-hollow-hoard/issue-002",{"seriesSlug":"the-hollow-hoard","seriesTitle":"The Hollow Hoard","issue":{"slug":"issue-002","number":2,"title":"The Borrowed Flame","nextTitle":"The Counterfeit Crown","summary":"Ren and Tamsin need a night of warmth for Latch. A kiln owner offers work, while a retrieval team follows their trail.","publishedAt":"2026-10-29T01:13:02.547Z","storyPages":12,"cover":"/comics/the-hollow-hoard/issue-002/images/00-cover.webp","pages":[{"number":0,"src":"/comics/the-hollow-hoard/issue-002/images/00-cover.webp","width":1024,"height":1536,"sha256":"a29801652f3c2ed66559d2a7626239dcd4301a029dd5946381e64cc5874abb92","description":"The Borrowed Flame, Edition 2 of The Hollow Hoard: cover.","dialogue":[]},{"number":1,"src":"/comics/the-hollow-hoard/issue-002/images/01.webp","width":1024,"height":1536,"sha256":"d660037bf62fa1e9d0259bbe31ed6f685eba651fc26e3a1ce02ee5995c12a9b8","description":"The bathhouse heat shuts off. Ren and Tamsin carry the cooling Latch toward the kiln district as a retrieval worker follows.","dialogue":["CAPTION: SILTMARKET. THE SAME NIGHT.","REN: Just a little longer.","BATHHOUSE KEEPER: Last vent. We're closed.","TAMSIN: Pella's. Now.","REN: I know.","WORKER: Found the appraiser."]},{"number":2,"src":"/comics/the-hollow-hoard/issue-002/images/02.webp","width":1024,"height":1536,"sha256":"882a2e24b60a627882dca94848c6c438bc6fb015cd0871ee8b0afaaa46ca9d88","description":"Tamsin spots their pursuer on a bridge. The pair evade the recovery order and turn into Pella’s workshop lane.","dialogue":["TAMSIN: Don't look back.","WORKER: Unreturned property. Hand it over.","REN: It's not property.","TAMSIN: Keep walking.","REN: She'll charge for this.","TAMSIN: Good. Then we can earn it."]},{"number":3,"src":"/comics/the-hollow-hoard/issue-002/images/03.webp","width":1024,"height":1536,"sha256":"3899f9c11ca8005ec7200cd5b32226e01a41c5165987b034dcb6958bc40df028","description":"Pella opens the kiln workshop, sees the exhausted Latch and offers Ren a repair job instead of free fuel.","dialogue":["PELLA: You said you'd fit a valve. Not arrive with a menagerie.","REN: It needs warmth. We'll work.","PELLA: No fuel till dawn. The old spring-water return is cold too.","PELLA: Fix the return. You get food and the loft.","REN: Fair."]},{"number":4,"src":"/comics/the-hollow-hoard/issue-002/images/04.webp","width":1024,"height":1536,"sha256":"9d73ae7122e1d94a1fe44a023487ac0670c1f3e9e9432cce82ff363fd3adda08","description":"Ren finds a cold return pipe capped during museum works. Upstairs, Tamsin watches the door while Latch rests beside protected warmth.","dialogue":["REN: Heat reaches here. It isn't reaching your bench.","PELLA: They called that a safety improvement.","REN: This cap's new. The blockage isn't age.","TAMSIN: We've got company."]},{"number":5,"src":"/comics/the-hollow-hoard/issue-002/images/05.webp","width":1024,"height":1536,"sha256":"9ea21db806ffc408490d362c7409286d54c6063b5ce1b6854ddd6074937354b7","description":"Captain Dane brings the recovery order to Pella’s door. Tamsin recognizes him and keeps the creature out of sight.","dialogue":["DANE: Marr. I thought you'd left the guild.","TAMSIN: I did. You still collecting for private buyers?","DANE: I collect what the order names.","PELLA: Your order names a key. My workshop isn't a crate."]},{"number":6,"src":"/comics/the-hollow-hoard/issue-002/images/06.webp","width":1024,"height":1536,"sha256":"3c8b694dd12f093bc39c964da80cd56b5ae3126c9837efaa23a283a514830bfb","description":"Ren and Tamsin agree on a plan: she will keep the maintenance exit clear while he repairs the heat return.","dialogue":["TAMSIN: I can draw them to the yard.","REN: How long do you need?","TAMSIN: Long enough to get behind them.","REN: I'll leave that unlatched. If the pipe fails, we both stop.","TAMSIN: Together, then."]},{"number":7,"src":"/comics/the-hollow-hoard/issue-002/images/07.webp","width":1024,"height":1536,"sha256":"1709563437890c98bb81caaa8b6379a14a5ba8d796a1757644b959a2872b88af","description":"Tamsin draws Dane into the delivery yard with an empty kiln cart, then uses a borrowed staff to reach the maintenance path.","dialogue":["SFX: CLATTER","DANE: Close the far gate. Don't rush her.","TAMSIN: Still slow at corners, Dane.","DANE: And still too sure of yourself."]},{"number":8,"src":"/comics/the-hollow-hoard/issue-002/images/08.webp","width":1024,"height":1536,"sha256":"10b015beb9719c94385bad0d180a3a18b9881927b0b965765b860f2eb2156102","description":"Ren isolates the hot pipe, waits for the pressure to fall and clears the return. Pella assists with the repair.","dialogue":["SFX: HSSS","REN: Too much pressure.","REN: Not the fast way.","PELLA: You know this isn't a relic?","REN: It still has to work.","REN: Water first. Your vent after."]},{"number":9,"src":"/comics/the-hollow-hoard/issue-002/images/09.webp","width":1024,"height":1536,"sha256":"0610b95dfd545fe0feafc8795dc7a3626616fe60466e0e056ea53a69e68b441a","description":"Tamsin rings the work bell before workers reach the open hot-pipe hatch. Ren and Pella carefully test the repaired return.","dialogue":["DANE: Wrong direction. They're below us.","SFX: CLANG","DANE: Stay back. That's a live line.","REN: Tell me the moment it moves."]},{"number":10,"src":"/comics/the-hollow-hoard/issue-002/images/10.webp","width":1024,"height":1536,"sha256":"f3470c15255dfbbf90c4e89495407eae1b23d86f9f419fa496baf9aadeb90427","description":"Warm water flows again and Latch revives. Dane leaves a return notice while Pella closes the workshop door.","dialogue":["PELLA: Steady. No leak.","REN: There you are.","DANE: This isn't over, Marr.","TAMSIN: Then bring a better order.","PELLA: My floor. My rules. Wash before you eat."]},{"number":11,"src":"/comics/the-hollow-hoard/issue-002/images/11.webp","width":1024,"height":1536,"sha256":"801e903483ea4ec0618637b7bf1cdc6c086e443d8bf1a12818d7deeb07b1f9f6","description":"The three share a late meal. Ren keeps his promise to fit Pella’s valve, and she offers the loft in exchange for maintenance work.","dialogue":["TAMSIN: You bought us a night.","REN: We earned it.","PELLA: And that?","REN: Still included.","REN: Not much like your spear.","TAMSIN: It held.","PELLA: Work while you stay. Settle your old rent in installments.","TAMSIN: We can do that."]},{"number":12,"src":"/comics/the-hollow-hoard/issue-002/images/12.webp","width":1024,"height":1536,"sha256":"7b9e90728991e330d2987dffecdd70a0c5d3b22922500ef34cda8bc38618e0fc","description":"Pella recognizes the mark on Latch’s clamp and shows an auction notice for specimen 002, listed beside a crown.","dialogue":["PELLA: I've seen that. On a consignment notice.","REN: Another key?","PELLA: A crown this time.","TAMSIN: If one object was alive...","REN: Tomorrow we go as buyers.","CAPTION: NEXT: THE COUNTERFEIT CROWN."]}],"pdf":"/comics/the-hollow-hoard/issue-002/The-Hollow-Hoard-02.pdf","pdfSha256":"ec083fdafbb13ba3623b8d7a044478f18bd1cc573f1b013543b082883bd625af","pdfBytes":21194183},"nextIssue":{"title":"The Counterfeit Crown","href":"/comics/the-hollow-hoard/issue-003"},"nextReleaseAt":null,"seasonEnd":false}]]
